    "faq_cookware": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "title": "What cookware should I buy first?",
            "text": "<p>Start with a 10\" to 12\" skillet, a 2 to 3 qt. saucepan with a lid, and a 5 to 7 qt. Dutch oven or stockpot. Add a saut&eacute; pan, wok or grill pan as your cooking grows.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "title": "Which cookware material is best?",
            "text": "<p>It depends on what you cook. Stainless steel is the most versatile, cast iron and carbon steel are best for high-heat searing, enameled cast iron excels at slow cooking, and nonstick is easiest for eggs and delicate fish. Many cooks own a mix.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "title": "Is your cookware induction-compatible?",
            "text": "<p>Most stainless steel, cast iron, carbon steel and enameled cast iron cookware works on induction. Some aluminum and copper pieces do not. Check each product page for the specific piece.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "title": "How do I care for cast iron and carbon steel?",
            "text": "<p>Rinse with hot water and a brush, dry it right away, and wipe on a thin coat of oil while the pan is warm. Skip the dishwasher and long soaks. If rust appears, scrub it off and re-season.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "title": "Can I put my cookware in the dishwasher?",
            "text": "<p>Many stainless steel and enameled pieces are dishwasher-safe, but hand washing keeps them looking new longer. Never put cast iron or carbon steel in the dishwasher. Follow the care notes on each product page.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "title": "Do you carry lids, racks and replacement parts?",
            "text": "<p>Yes. Browse <a href=\"/collections/cookware-accessories\">cookware accessories</a> for lids, roasting racks, steamer inserts, handle covers and more.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "title": "Can I see cookware in person or pick up my order?",
            "text": "<p>Yes. Visit our Buncombe Street shop in Greenville, SC, or order online and choose local pickup at checkout.</p>"
          }
        }
      },
