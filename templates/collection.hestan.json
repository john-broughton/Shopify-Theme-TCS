    "faq_hestan": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "title": "Where is Hestan cookware made?",
            "text": "<p>Hestan makes its NanoBond, ProBond, CopperBond and TITUM cookware in its own factories in Italy.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "title": "What is the difference between Hestan NanoBond, ProBond and CopperBond?",
            "text": "<p>All three are clad stainless steel and work on induction. ProBond is tri-ply stainless steel with an aluminum core and is the best everyday value. NanoBond adds a titanium-bonded surface that is harder and more stain-resistant, and it's oven-safe to 1050°F. CopperBond uses a pure copper core for the fastest response to heat.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "title": "Is Hestan cookware worth the price?",
            "text": "<p>For cooks who want pans that last for decades, yes. Hestan cookware is fully clad, has flush rivets that make cleaning easier, and comes with a lifetime warranty. If you're choosing one pan, ProBond gives you Hestan's construction at the lowest price. NanoBond is worth the upgrade if you want the most durable, easiest-to-clean stainless surface.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "title": "Is Hestan cookware oven-safe?",
            "text": "<p>Yes. NanoBond is oven- and broiler-safe to 1050°F. ProBond and CopperBond are oven-safe to 600°F. TITUM nonstick is oven-safe to 500°F but shouldn't go on a grill.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "title": "Does Hestan cookware work on induction?",
            "text": "<p>Yes. NanoBond, ProBond, CopperBond and TITUM all work on induction, gas, electric and ceramic cooktops.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "title": "Is Hestan cookware dishwasher-safe?",
            "text": "<p>NanoBond, ProBond and TITUM are dishwasher-safe. Hestan recommends hand washing CopperBond. Hand washing helps any stainless pan keep its finish longer.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "title": "Is Hestan TITUM nonstick safe?",
            "text": "<p>TITUM uses a PTFE-based nonstick coating made without PFOA. Like any nonstick pan, avoid heating it empty on high heat. It's oven-safe to 500°F.</p>"
          }
        },
        "q8": {
          "type": "question",
          "settings": {
            "title": "Does Hestan have a warranty?",
            "text": "<p>Yes. Hestan cookware has a lifetime warranty against defects in materials and workmanship.</p>"
          }
        },
        "q9": {
          "type": "question",
          "settings": {
            "title": "How do I keep food from sticking to Hestan stainless steel?",
            "text": "<p>Heat the pan over medium for a minute or two, add oil, and let it shimmer before adding food. Let proteins release on their own before flipping. A splash of water and a soft sponge removes most residue.</p>"
          }
        },
        "q10": {
          "type": "question",
          "settings": {
            "title": "Can I see Hestan cookware in person in Greenville?",
            "text": "<p>Yes. The Cook's Station carries Hestan at our Buncombe Street shop in Greenville, SC. You can also order online and choose local pickup at checkout.</p>"
          }
        }
      },
