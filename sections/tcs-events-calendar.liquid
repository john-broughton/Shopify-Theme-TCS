  @media (max-width:700px){#tcs-cal-{{ section.id }} .tcs-cal__pop{width:auto;left:16px !important;right:16px;max-width:none}#tcs-cal-{{ section.id }} .fc .fc-toolbar{flex-wrap:nowrap;gap:8px}#tcs-cal-{{ section.id }} .fc .fc-toolbar-title{font-size:20px;text-align:center}}
  #tcs-cal-{{ section.id }} .tcs-cal__pop-img img{display:block;width:100%;height:auto;max-height:180px;object-fit:cover;border-radius:4px;margin-bottom:10px}
