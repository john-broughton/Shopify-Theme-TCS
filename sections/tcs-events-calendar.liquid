  #tcs-cal-{{ section.id }} .tcs-cal__pop-status.is-sold{color:#E11900}
  #tcs-cal-{{ section.id }} .tcs-cal__pop-private{margin-top:8px}
  #tcs-cal-{{ section.id }} .tcs-cal__pop-btn{display:block;margin-top:16px;text-align:center}
  #tcs-cal-{{ section.id }} .tcs-cal__filters{margin:0 0 14px}
  #tcs-cal-{{ section.id }} .tcs-cal__chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
  #tcs-cal-{{ section.id }} .tcs-cal__chip{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;line-height:1.2;font:inherit;font-size:14px;min-height:40px;padding:6px 14px;border:1px solid #CFCFCF;border-radius:999px;background:#fff;color:#252525;cursor:pointer}
  #tcs-cal-{{ section.id }} .tcs-cal__chip small{display:inline;font-size:12px;opacity:.7;margin:0}
  #tcs-cal-{{ section.id }} .tcs-cal__chip[aria-pressed="true"]{background:#252525;border-color:#252525;color:#fff}
  #tcs-cal-{{ section.id }} .tcs-cal__chip:focus-visible,#tcs-cal-{{ section.id }} .tcs-cal__reset:focus-visible{outline:2px solid #252525;outline-offset:2px}
  #tcs-cal-{{ section.id }} .tcs-cal__row{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;justify-content:center;margin-top:12px;font-size:14px}
  #tcs-cal-{{ section.id }} .tcs-cal__tog{display:inline-flex;align-items:center;gap:6px;min-height:40px;cursor:pointer;margin:0}
  #tcs-cal-{{ section.id }} .tcs-cal__tog input{width:18px;height:18px;margin:0}
  #tcs-cal-{{ section.id }} .tcs-cal__search input{font:inherit;font-size:16px;min-height:40px;width:260px;max-width:100%;padding:6px 12px;border:1px solid #CFCFCF;border-radius:6px;margin:0}
  #tcs-cal-{{ section.id }} .tcs-cal__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  #tcs-cal-{{ section.id }} .tcs-cal__empty{text-align:center;margin:12px 0 0;font-size:14px}
  #tcs-cal-{{ section.id }} .tcs-cal__reset{font:inherit;background:none;border:0;padding:0;text-decoration:underline;cursor:pointer;color:inherit}
  @media (max-width:700px){#tcs-cal-{{ section.id }} .tcs-cal__chips{flex-wrap:nowrap;overflow-x:auto;justify-content:flex-start;padding-bottom:4px;-webkit-overflow-scrolling:touch;scrollbar-width:none}#tcs-cal-{{ section.id }} .tcs-cal__chips::-webkit-scrollbar{display:none}#tcs-cal-{{ section.id }} .tcs-cal__chip{flex:0 0 auto}#tcs-cal-{{ section.id }} .tcs-cal__search{flex:1 1 100%}#tcs-cal-{{ section.id }} .tcs-cal__search input{width:100%}}
  #tcs-cal-{{ section.id }} .tcs-cal__views{display:flex;justify-content:center;margin:0 0 10px}
  #tcs-cal-{{ section.id }} .tcs-cal__views[hidden]{display:none}
  #tcs-cal-{{ section.id }} .tcs-cal__views button{font:inherit;font-size:14px;min-height:40px;padding:6px 16px;border:1px solid #CFCFCF;background:#fff;color:#252525;cursor:pointer;margin:0}
  #tcs-cal-{{ section.id }} .tcs-cal__views button:first-child{border-radius:6px 0 0 6px}
  #tcs-cal-{{ section.id }} .tcs-cal__views button:last-child{border-radius:0 6px 6px 0;border-left:0}
  #tcs-cal-{{ section.id }} .tcs-cal__views button[aria-pressed="true"]{background:#252525;border-color:#252525;color:#fff}
  #tcs-cal-{{ section.id }} .tcs-cal__views button:focus-visible{outline:2px solid #252525;outline-offset:2px}
</style>

<script>
(function () {
  var root = document.getElementById('tcs-cal-{{ section.id }}');
  if (!root || root.__tcs) return; root.__tcs = true;

  var FEED = '/collections/{{ feed_handle }}?view=calendar-json';
  var PRIVATE_FEED = '/collections/{{ feed_handle }}?view=private-bookings-json';
  var FEW_SEATS = {{ section.settings.few_seats | default: 3 }};
  var PRIVATE_LABEL = {{ section.settings.private_label | default: 'Private Event' | json }};
  var SHOW_SPACE = {{ section.settings.show_space | json }};
  var DEFAULT_MIN = { 'Lunch & Learn': 60, 'Chef Dinners': 150, 'Café Nights': 210, 'Game Nights': 120 };
  var FALLBACK_MIN = {{ section.settings.default_minutes | default: 120 }};

  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function isoLocal(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':00'; }

  // "Pasta 101 12/12/2026 2pm" -> Date
  function dateFromTitle(t) {
    var m = String(t).match(/(\d{1,2})\/(\d{1,2})\/(\d{4})\s*(?:at\s*)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)/i);
    if (!m) return null;
    var h = parseInt(m[4], 10) % 12 + (m[6].toLowerCase() === 'pm' ? 12 : 0);
    return new Date(+m[3], +m[1] - 1, +m[2], h, m[5] ? +m[5] : 0);
  }
  function cleanTitle(t) {
    return String(t).replace(/\s*-?\s*\d{1,2}\/\d{1,2}\/\d{4}.*$/, '').trim();
  }
  function statusOf(p) {
    if (p.private) return 'private';
    if (p.price_max === 0) return 'free';
    if (!p.available) return 'sold';
    if (p.tracked && p.seats > 0 && p.seats <= FEW_SEATS) return 'few';
    return 'open';
  }

  function toEvent(p) {
    var start = p.start ? new Date(p.start) : dateFromTitle(p.title);
    if (!start || isNaN(start)) return null;
    var end = p.end ? new Date(p.end) : new Date(start.getTime() + (DEFAULT_MIN[p.type] || FALLBACK_MIN) * 60000);
    var status = statusOf(p);
    var space = SHOW_SPACE ? (p.space || '') : '';
    var label = (p.private && p.url === null && p.title) ? p.title : PRIVATE_LABEL;
    var title = p.private ? label + (space ? ' · ' + space : '') : cleanTitle(p.title);
    return {
      id: String(p.id), title: title, start: isoLocal(start), end: isoLocal(end),
      classNames: ['s-' + status], display: 'block',
      extendedProps: { p: p, status: status, space: space }
    };
  }

  function loadFeed(url, optional) {
    var all = [];
    function page(n) {
      return fetch(url + '&page=' + n, { credentials: 'same-origin' })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
        .then(function (data) {
          all = all.concat(data.events || []);
          return n < (data.pages || 1) ? page(n + 1) : all;
        });
    }
    var run = page(1);
    // The private bookings feed is optional: if it isn't installed, the calendar still loads.
    return optional ? run.catch(function () { return all; }) : run;
  }
  function loadAll() {
    return Promise.all([loadFeed(FEED, false), loadFeed(PRIVATE_FEED, true)])
      .then(function (r) { return r[0].concat(r[1]); });
  }

  var pop = root.querySelector('.tcs-cal__pop');
  var lastEl = null;
  function closePop() { if (pop.hidden) return; pop.hidden = true; if (lastEl && pop.contains(document.activeElement)) lastEl.focus(); }
  root.querySelector('.tcs-cal__close').addEventListener('click', closePop);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePop(); });
  window.addEventListener('resize', place);
  document.addEventListener('click', function (e) {
    if (!pop.hidden && !pop.contains(e.target) && !e.target.closest('.fc-event')) closePop();
  });

  function showPop(info) {
    if (info.jsEvent) info.jsEvent.preventDefault();
    var ev = info.event, x = ev.extendedProps, p = x.p;
    var fmtDay = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
    var fmtTime = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit' });
    pop.querySelector('.tcs-cal__pop-title').textContent = ev.title;
    pop.querySelector('.tcs-cal__pop-date').textContent = fmtDay.format(ev.start) + ' · ' + fmtTime.format(ev.start) + (p.private && ev.end ? ' – ' + fmtTime.format(ev.end) : '');
    var spaceEl = pop.querySelector('.tcs-cal__pop-space');
    spaceEl.textContent = x.space ? 'Space booked: ' + x.space : '';
    var st = pop.querySelector('.tcs-cal__pop-status');
    st.className = 'tcs-cal__pop-status';
    var labels = {
      open: p.price_label, few: p.price_label + ' · Only ' + p.seats + ' left',
      sold: 'Sold out', free: p.admission === 'Free RSVP' ? 'Free · RSVP' : 'Free entry · pay as you order', private: ''
    };
    st.textContent = labels[x.status] || '';
    if (x.status === 'sold') st.classList.add('is-sold');
    pop.querySelector('.tcs-cal__pop-private').style.display = p.private ? '' : 'none';
    var img = pop.querySelector('.tcs-cal__pop-img'), im = img.querySelector('img');
    img.classList.remove('is-ready'); im.onload = null; im.removeAttribute('src');
    if (p.image && !p.private) {
      var want = p.image;
      im.onload = function () { if (im.getAttribute('src') === want) { img.classList.add('is-ready'); place(); } };
      im.alt = ev.title; im.setAttribute('src', want);
    }
    var btn = pop.querySelector('.tcs-cal__pop-btn');
    btn.style.display = p.private ? 'none' : '';
    btn.href = p.url; btn.textContent = x.status === 'sold' ? 'Join the waitlist' : (x.status === 'free' && p.admission === 'Free RSVP' ? 'RSVP' : 'View event');

    lastEl = info.el;
    pop.setAttribute('aria-label', ev.title);
    pop.hidden = false;
    place();
    if (info.fromKeyboard) pop.querySelector('.tcs-cal__close').focus();
  }
  // Put the card right under (or above) the event that was clicked or tapped.
  function place() {
    if (pop.hidden || !lastEl) return;
    var r = root.getBoundingClientRect(), e = lastEl.getBoundingClientRect(), w = pop.offsetWidth, h = pop.offsetHeight;
    var left = Math.min(Math.max(8, e.left + e.width / 2 - r.left - w / 2), r.width - w - 8);
    var top = e.bottom - r.top + 8;
    if (e.bottom + h + 16 > window.innerHeight && e.top - h - 8 > 70) top = e.top - r.top - h - 8;
    pop.style.left = left + 'px'; pop.style.top = Math.max(0, top) + 'px';
  }

  // ---------- filters (Event Type chips, Free only, Hide sold out, search) ----------
  // Chips are built from each product's Event Type, so a new type gets its own chip automatically.
  // Link straight to a filter with ?event_type=Kids (matches the Event Type name).
  function setupFilters(cal, events) {
    var box = root.querySelector('.tcs-cal__filters');
    if (!box) { cal.addEventSource(events); return; }
    var chips = box.querySelector('.tcs-cal__chips'), empty = box.querySelector('.tcs-cal__empty');
    var fFree = box.querySelector('[data-f="free"]'), fSold = box.querySelector('[data-f="sold"]'), fQ = box.querySelector('[data-f="q"]');
    var want = new URLSearchParams(location.search).get('event_type');
    var state = { type: 'all' };
    var source = null, timer = null;
    function typeOf(e) { return e.extendedProps.p.type || ''; }
    function passToggles(e) {
      var s = e.extendedProps.status;
      if (fFree.checked && s !== 'free') return false;
      if (fSold.checked && s === 'sold') return false;
      return true;
    }
    function passSearch(e) {
      var q = fQ.value.trim().toLowerCase();
      return !q || (e.title + ' ' + typeOf(e)).toLowerCase().indexOf(q) !== -1;
    }
    function passType(e) { return state.type === 'all' || (!e.extendedProps.p.private && typeOf(e) === state.type); }
    function drawChips() {
      // Counts show upcoming events only (past ones still appear when you page back).
      var now = new Date(), counts = {}, base = events.filter(function (e) { return new Date(e.end) >= now && passToggles(e) && passSearch(e); });
      base.forEach(function (e) { var t = typeOf(e); if (t && !e.extendedProps.p.private) counts[t] = (counts[t] || 0) + 1; });
      var types = Object.keys(counts).sort(function (a, b) { return counts[b] - counts[a] || (a < b ? -1 : 1); });
      if (state.type !== 'all' && types.indexOf(state.type) === -1) types.push(state.type);
      chips.innerHTML = '';
      [['all', 'All', base.length]].concat(types.map(function (t) { return [t, t, counts[t] || 0]; })).forEach(function (c) {
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'tcs-cal__chip'; b.setAttribute('aria-pressed', String(state.type === c[0]));
        b.appendChild(document.createTextNode(c[1]));
        var n = document.createElement('small'); n.textContent = c[2]; b.appendChild(n);
        b.addEventListener('click', function () { state.type = c[0]; apply(); });
        chips.appendChild(b);
      });
      var on = chips.querySelector('[aria-pressed="true"]');
      if (on && chips.scrollWidth > chips.clientWidth) chips.scrollLeft += on.getBoundingClientRect().left - chips.getBoundingClientRect().left - 16;
    }
    function apply() {
      closePop();
      var list = events.filter(function (e) { return passType(e) && passToggles(e) && passSearch(e); });
      if (source) source.remove();
      source = cal.addEventSource(list);
      empty.hidden = list.length > 0;
      drawChips();
    }
    if (want) {
      var match = events.map(typeOf).filter(function (t) { return t && t.toLowerCase() === want.toLowerCase(); })[0];
      if (match) state.type = match;
    }
    fFree.addEventListener('change', apply);
    fSold.addEventListener('change', apply);
    fQ.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(apply, 200); });
    box.querySelector('.tcs-cal__reset').addEventListener('click', function () {
      state.type = 'all'; fFree.checked = false; fSold.checked = false; fQ.value = ''; apply();
    });
    apply();
  }

  function start() {
    var grid = root.querySelector('.tcs-cal__grid');
    var loading = root.querySelector('.tcs-cal__loading');
    var mobile = window.matchMedia('(max-width: 700px)').matches;
    var cal = new FullCalendar.Calendar(grid, {
      // Phones: a list for this month (month/week grids are too cramped). Past days are skipped on phones.
      initialView: mobile ? 'listMonth' : 'dayGridMonth',
      validRange: mobile ? function (now) { var d = new Date(now); d.setHours(0, 0, 0, 0); return { start: d }; } : {},
      headerToolbar: mobile ? { left: 'prev', center: 'title', right: 'next' } : { left: 'title', right: 'listThisWeek dayGridMonth timeGridWeek listMonth prev,next' },
      buttonText: { month: 'month', week: 'week grid', listMonth: 'list' },
      views: {
        // "This week" = a simple list of the next 7 days, starting today.
        listThisWeek: { type: 'list', duration: { days: 7 }, dateIncrement: { days: 7 }, dateAlignment: 'day', buttonText: 'this week' }
      },
      noEventsContent: 'No events in these dates. Use the arrows to see more.',
      datesSet: function (d) {
        root.querySelectorAll('.tcs-cal__views button').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-view') === d.view.type)); });
      },
      // Week view: show the store's day, not midnight to 8am.
      slotMinTime: '08:00:00', slotMaxTime: '22:00:00', allDaySlot: false,
      height: 'auto', eventDisplay: 'block', dayMaxEvents: false,
      eventTimeFormat: { hour: 'numeric', minute: '2-digit', meridiem: 'short' },
      eventClick: showPop,
      eventDidMount: function (info) {
        var x = info.event.extendedProps, el = info.el, ev = info.event;
        var when = new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(ev.start);
        var said = { open: '', few: ', only ' + x.p.seats + ' left', sold: ', sold out', free: ', free', private: '' };
        el.setAttribute('tabindex', '0'); el.setAttribute('role', 'button');
        el.setAttribute('aria-label', ev.title + ', ' + when + (said[x.status] || ''));
        el.addEventListener('keydown', function (k) {
          if (k.key === 'Enter' || k.key === ' ') { k.preventDefault(); showPop({ event: ev, el: el, jsEvent: null, fromKeyboard: true }); }
        });
        if (x.status === 'few') {
          var t = info.el.querySelector('.fc-event-title, .fc-list-event-title a');
          if (t) { var b = document.createElement('span'); b.className = 'tcs-left'; b.textContent = '· ' + x.p.seats + ' left'; t.appendChild(b); }
        }
      }
    });
    cal.render();
    if (mobile) {
      var vs = root.querySelector('.tcs-cal__views');
      vs.hidden = false;
      vs.querySelectorAll('button').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.getAttribute('data-view') === cal.view.type));
        b.addEventListener('click', function () { closePop(); cal.changeView(b.getAttribute('data-view'), new Date()); });
      });
    }
    loadAll().then(function (list) {
      var events = list.map(toEvent).filter(Boolean);
      setupFilters(cal, events);
      loading.style.display = 'none';
    }).catch(function (e) {
      loading.textContent = 'Events could not load. Please refresh the page.';
      console.error('[TCS calendar]', e);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
})();
</script>

{% schema %}
{
  "name": "Classes & Events Calendar",
  "tag": "section",
  "class": "index-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Calendar" },
    { "type": "collection", "id": "collection", "label": "Calendar collection", "info": "Use the automated \"Calendar\" collection (Product type = Event). Every product in it shows on the calendar." },
    { "type": "checkbox", "id": "show_legend", "label": "Show color key", "default": true },
    { "type": "checkbox", "id": "show_filters", "label": "Show filters", "default": true, "info": "Event Type chips, Free only, Hide sold out and search. Chips come from each product's Event Type." },
    { "type": "range", "id": "few_seats", "label": "\"Only a few left\" at or below", "min": 1, "max": 10, "step": 1, "default": 3 },
    { "type": "range", "id": "default_minutes", "label": "Default length when no end time (minutes)", "min": 30, "max": 300, "step": 30, "default": 120 },
    { "type": "header", "content": "Private events" },
    { "type": "text", "id": "private_label", "label": "Label on the calendar", "default": "Private Event" },
    { "type": "checkbox", "id": "show_space", "label": "Show the space booked", "default": true, "info": "e.g. Private Event · Patio" },
    { "type": "textarea", "id": "private_message", "label": "Message when clicked", "default": "Interested in booking a private event? Email events@thecooksstation.com." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "c_open", "label": "Seats available", "default": "#1F3A5F" },
    { "type": "color", "id": "c_few", "label": "Only a few left", "default": "#C9822B" },
    { "type": "color", "id": "c_sold", "label": "Sold out", "default": "#E3E3E3" },
    { "type": "color", "id": "c_free", "label": "Free", "default": "#2E7D46" },
    { "type": "color", "id": "c_private", "label": "Private / booked", "default": "#7A2E1F" }
  ],
  "presets": [{ "name": "Classes & Events Calendar" }]
}
{% endschema %}
