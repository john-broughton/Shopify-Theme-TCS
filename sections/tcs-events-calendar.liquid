{%- comment -%}
  TCS Classes & Events Calendar (Shopify-only version)
  Reads every event product from the "Calendar" collection through
  /collections/<handle>?view=calendar-json, so new products appear automatically.
  No Evey feed and no hand-typed lists.
{%- endcomment -%}
{%- liquid
  assign cal_collection = section.settings.collection
  assign feed_handle = 'calendar'
  if cal_collection != blank
    assign feed_handle = cal_collection.handle
  endif
-%}
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.9.0/main.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.9.0/main.min.js"></script>

<div class="tcs-cal" id="tcs-cal-{{ section.id }}">
  <div class="tcs-cal__head">
    {%- if section.settings.title != blank -%}<h2 class="tcs-cal__title">{{ section.settings.title | escape }}</h2>{%- endif -%}
    {%- if section.settings.show_legend -%}
    <div class="tcs-cal__legend">
      <span><i class="k-open"></i>Seats available</span>
      <span><i class="k-few"></i>Only a few left</span>
      <span><i class="k-sold"></i>Sold out</span>
      <span><i class="k-free"></i>Free</span>
      <span><i class="k-private"></i>Private event / booked</span>
    </div>
    {%- endif -%}
  </div>
  {%- if section.settings.show_filters -%}
  <div class="tcs-cal__filters">
    <div class="tcs-cal__chips" role="group" aria-label="Type of event"></div>
    <div class="tcs-cal__row">
      <label class="tcs-cal__tog"><input type="checkbox" data-f="free"> <span>Free only</span></label>
      <label class="tcs-cal__tog"><input type="checkbox" data-f="sold"> <span>Hide sold out</span></label>
      <label class="tcs-cal__search"><span class="tcs-cal__sr">Search events</span><input type="search" data-f="q" placeholder="Search: pasta, sushi, wine…"></label>
    </div>
    <p class="tcs-cal__empty" hidden>Nothing matches those filters. <button type="button" class="tcs-cal__reset">Show everything</button></p>
  </div>
  {%- endif -%}
  <div class="tcs-cal__loading">Loading events…</div>
  <div class="tcs-cal__views" role="group" aria-label="Show" hidden>
    <button type="button" data-view="listThisWeek" aria-pressed="false">This week</button>
    <button type="button" data-view="listMonth" aria-pressed="false">This month</button>
  </div>
  <div class="tcs-cal__grid"></div>

  <div class="tcs-cal__pop" role="dialog" aria-modal="false" hidden>
    <button type="button" class="tcs-cal__close" aria-label="Close">×</button>
    <div class="tcs-cal__pop-img"><img alt=""></div>
    <div class="tcs-cal__pop-title"></div>
    <div class="tcs-cal__pop-date"></div>
    <div class="tcs-cal__pop-space"></div>
    <div class="tcs-cal__pop-status"></div>
    <div class="tcs-cal__pop-private">{{ section.settings.private_message }}</div>
    <a class="btn tcs-cal__pop-btn" href="#">View event</a>
  </div>
</div>

<style>
